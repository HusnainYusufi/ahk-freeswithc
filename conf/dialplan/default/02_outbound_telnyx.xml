<include>
  <!-- Outbound calls via Telnyx Gateway -->
  
  <!-- US/Canada 11-digit (1NXXNXXXXXX) -->
  <extension name="outbound_us_can_11digit">
    <condition field="destination_number" expression="^(1[2-9]\d{9})$">
      <action application="set" data="effective_caller_id_number=+19495431333"/>
      <action application="set" data="effective_caller_id_name=FreeSWITCH"/>
      <action application="set" data="ignore_early_media=false"/>
      <action application="set" data="ringback=${us-ring}"/>
      <action application="bridge" data="sofia/gateway/telnyx/+$1"/>
    </condition>
  </extension>

  <!-- US/Canada 10-digit (NXXNXXXXXX) - prepend +1 -->
  <extension name="outbound_us_can_10digit">
    <condition field="destination_number" expression="^([2-9]\d{9})$">
      <action application="set" data="effective_caller_id_number=+19495431333"/>
      <action application="set" data="effective_caller_id_name=FreeSWITCH"/>
      <action application="set" data="ignore_early_media=false"/>
      <action application="set" data="ringback=${us-ring}"/>
      <action application="bridge" data="sofia/gateway/telnyx/+1$1"/>
    </condition>
  </extension>

  <!-- International calls starting with 011 -->
  <extension name="outbound_international">
    <condition field="destination_number" expression="^(011\d+)$">
      <action application="set" data="effective_caller_id_number=+19495431333"/>
      <action application="set" data="effective_caller_id_name=FreeSWITCH"/>
      <action application="set" data="ignore_early_media=false"/>
      <action application="set" data="ringback=${us-ring}"/>
      <action application="bridge" data="sofia/gateway/telnyx/+${destination_number:3}"/>
    </condition>
  </extension>

  <!-- E.164 format (numbers starting with +) -->
  <extension name="outbound_e164">
    <condition field="destination_number" expression="^(\+\d+)$">
      <action application="set" data="effective_caller_id_number=+19495431333"/>
      <action application="set" data="effective_caller_id_name=FreeSWITCH"/>
      <action application="set" data="ignore_early_media=false"/>
      <action application="set" data="ringback=${us-ring}"/>
      <action application="bridge" data="sofia/gateway/telnyx/$1"/>
    </condition>
  </extension>

  <!-- Pakistan direct (923XXXXXXXXX) - prepend + -->
  <extension name="outbound_pakistan">
    <condition field="destination_number" expression="^(923\d{9})$">
      <action application="set" data="effective_caller_id_number=+19495431333"/>
      <action application="set" data="effective_caller_id_name=FreeSWITCH"/>
      <action application="set" data="ignore_early_media=false"/>
      <action application="set" data="ringback=${us-ring}"/>
      <action application="bridge" data="sofia/gateway/telnyx/+$1"/>
    </condition>
  </extension>

  <!-- International calls starting with 00 (European format) -->
  <extension name="outbound_international_00">
    <condition field="destination_number" expression="^(00\d+)$">
      <action application="set" data="effective_caller_id_number=+19495431333"/>
      <action application="set" data="effective_caller_id_name=FreeSWITCH"/>
      <action application="set" data="ignore_early_media=false"/>
      <action application="set" data="ringback=${us-ring}"/>
      <action application="bridge" data="sofia/gateway/telnyx/+${destination_number:2}"/>
    </condition>
  </extension>

</include>
